{
  "name": "oneseat",
  "private": true,
  "version": "0.1.0",
  "description": "Oblige, compliance by design: can I keep selling this product, in this country, on this marketplace? (built on the OneSeat engine)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:skills": "pnpm --filter @oneseat/registry run lint:skills",
    "gates": "pnpm --filter @oneseat/testkit run gates",
    "clean": "turbo run clean && rm -rf node_modules",
    "lint:rules": "pnpm --filter @oneseat/rulebook lint:rules",
    "audit:example": "pnpm --filter @oneseat/obligations gap-audit -- --catalog ../../examples/audit/catalog.csv --seller ../../examples/audit/seller.json --rules ../../rules --today 2026-11-28 --html ../../examples/audit/sample-report.html --md ../../examples/audit/sample-report.md"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  }
}
