{
  "name": "@oneseat/gateway",
  "version": "0.1.0",
  "description": "ModelProvider adapters: Anthropic Messages, OpenAI Responses (Codex), Google Gemini, local OpenAI-compatible.",
  "type": "module",
  "exports": {
    ".": {
      "@oneseat/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=src/** --coverage.reporter=text --coverage.reporter=json-summary --coverage.thresholds.lines=90",
    "test:live": "ONESEAT_LIVE=1 vitest run test/live.test.ts",
    "record": "ONESEAT_RECORD=1 vitest run test/conformance.test.ts",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@oneseat/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12",
    "@oneseat/testkit": "workspace:*"
  }
}
