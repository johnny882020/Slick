{
  "name": "@oneseat/harness",
  "version": "0.1.0",
  "description": "Agent loop, skill router, tool runner, MCP client, Deno sandbox, memory, scheduler, approvals and the daemon JSON-RPC server.",
  "type": "module",
  "exports": {
    ".": {
      "@oneseat/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@oneseat/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.12",
    "deno": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12",
    "@oneseat/testkit": "workspace:*"
  }
}
