        {
          "type": "regex",
          "pattern": "\\d{1,3}\\s*/\\s*280",
          "flags": "i"
        },
        {
          "type": "contains",
          "value": "sourdough",
          "caseSensitive": false
        },
        {
          "type": "regex",
          "pattern": "Dec(ember)? 5|12/5",
          "flags": "i"
        }
      ]
    },
